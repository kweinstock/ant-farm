/**
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Path-based project. Routes attach to the existing kweinstock.dev /
 * testing.kweinstock.dev records owned by the landing-page Worker, so there is
 * no new DNS record or certificate to create. The most specific route wins, so
 * "/ant-farm/*" comes here and everything else falls through to the landing page.
 * 
 * "main" now points at the Worker entry (src/worker/index.ts) instead
 * of this being an assets-only project. COLONY is the single ColonyDO Durable
 * Object, created once and referenced by name ("global-colony") from
 * src/worker/index.ts. SQLite-backed (new_sqlite_classes below) so Phase 14's
 * persistence can use the DO's own storage without a second migration.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ant-farm",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "binding": "assets",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      {"name": "COLONY", "class_name": "ColonyDO"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["ColonyDO"]}
  ],
  "routes": [
    { "pattern": "kweinstock.dev/ant-farm/*", "zone_name": "kweinstock.dev" }
  ],
  "env": {
    "testing": {
      "name": "ant-farm-testing",
      "routes": [
        { "pattern": "testing.kweinstock.dev/ant-farm/*", "zone_name": "kweinstock.dev" }
      ],
      "durable_objects": {
        "bindings": [
          {"name": "COLONY", "class_name": "ColonyDO"}
        ]
      },
      "migrations": [
        {"tag": "v1", "new_sqlite_classes": ["ColonyDO"]}
      ]
    }
  }
}
