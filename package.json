{
  "name": "ant-farm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy": "npm run build && wrangler deploy",
    "deploy:testing": "npm run build && wrangler deploy --env testing",
