    "test:basic": "npx tsx scripts/print-sim.ts",
    "optimize-params": "npx tsx scripts/optimize-params.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.186.0",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
