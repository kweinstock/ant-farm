{
  "name": "ant-farm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p tsconfig.worker.json && tsc -p test/worker/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy": "npm run build && wrangler deploy",
    "deploy:testing": "npm run build && wrangler deploy --env testing",
    "test": "vitest run",
    "test:worker": "npm run test -w test/worker",
    "test:basic": "npx tsx scripts/print-sim.ts",
    "diagnose-death": "npx tsx scripts/print-sim.ts --full",
    "optimize-params": "npx tsx scripts/optimize-params.ts",
    "optimize-params-parallel": "npx tsx scripts/optimize-params-parallel.ts"
  },
  "workspaces": ["test/worker"],
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.186.0",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
