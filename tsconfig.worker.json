{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": ["ES2022"],
    "types": ["./worker-configuration.d.ts"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/worker", "src/sim", "src/shared", "worker-configuration.d.ts"]
}